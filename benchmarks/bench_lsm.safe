program bench_lsm;
import io;
import std;
import lsm;
import binary;
import file;

const int N = 10000;
const string DIR = "/tmp/_safe_bench_lsm";

int t0 = std:time();
LSM db = lsm:create(DIR);

for i in 0..(N-1) {
    string k = "k" + std:str(i);
    bytes v = binary:encode("v" + std:str(i));
    db = lsm:put(db, k, v);
}

int t1 = std:time();

int found = 0;
for i in 0..(N-1) {
    string k = "k" + std:str(i);
    bytes r = lsm:get(db, k);
    found = if (binary:length(r) > 0) then found + 1 else found;
}

int t2 = std:time();

file:rmdir(DIR);

io:println("=== lsm ===");
io:println("records: " + std:str(N));
io:println("write: " + std:str(t1 - t0) + "ms");
io:println("read: " + std:str(t2 - t1) + "ms");
io:println("found: " + std:str(found));
