module datetime;

public type Timestamp {
    public const int millis;
}

public Timestamp now() {
    return Timestamp { millis: time() };
}

public Timestamp create(int y, int mo, int d, int h, int mi, int s) {
    return Timestamp { millis: epoch(y, mo, d) * 86400000 + h * 3600000 + mi * 60000 + s * 1000 };
}

public int year(Timestamp t) {
    return component(t.millis, 0);
}

public int month(Timestamp t) {
    return component(t.millis, 1);
}

public int day(Timestamp t) {
    return component(t.millis, 2);
}

public int hour(Timestamp t) {
    return (t.millis / 3600000) % 24;
}

public int minute(Timestamp t) {
    return (t.millis / 60000) % 60;
}

public int second(Timestamp t) {
    return (t.millis / 1000) % 60;
}

public int weekday(Timestamp t) {
    const int days = t.millis / 86400000;
    return (days + 3) % 7;
}

public string format(Timestamp t) {
    return date(t) + "T" + pad(hour(t)) + ":" + pad(minute(t)) + ":" + pad(second(t)) + "Z";
}

public string date(Timestamp t) {
    return str(year(t)) + "-" + pad(month(t)) + "-" + pad(day(t));
}

public Timestamp add(Timestamp t, int days) {
    return Timestamp { millis: t.millis + days * 86400000 };
}

public int diff(Timestamp a, Timestamp b) {
    return (a.millis - b.millis) / 86400000;
}

public boolean leap(int y) {
    return y % 4 == 0 && (y % 100 != 0 || y % 400 == 0);
}

// Days in a given month (1-12)
public int daysinmonth(int y, int m) {
    return case m of {
        1: 31; 2: if (leap(y)) then 29 else 28; 3: 31; 4: 30;
        5: 31; 6: 30; 7: 31; 8: 31; 9: 30; 10: 31; 11: 30; 12: 31;
        _: 0;
    };
}

// Days from Unix epoch (1970-01-01) to start of given date
int epoch(int y, int m, int d) {
    int days = 0;
    int yr = 1970;
    while (yr < y) bound (y - 1969) {
        const int ydays = if (leap(yr)) then 366 else 365;
        days = days + ydays;
        yr = yr + 1;
    }
    int mo = 1;
    while (mo < m) bound (12) {
        days = days + daysinmonth(y, mo);
        mo = mo + 1;
    }
    return days + d - 1;
}

// Extract year(0), month(1), or day(2) from millis
int component(int millis, int which) {
    int days = millis / 86400000;
    int y = 1970;
    int remaining = days;
    int ylen = if (leap(y)) then 366 else 365;
    while (remaining >= ylen) bound (days + 1) {
        remaining = remaining - ylen;
        y = y + 1;
        ylen = if (leap(y)) then 366 else 365;
    }
    // ylen used as loop variable above
    return if (which == 0) then y
    else do {
        int m = 1;
        int mlen = daysinmonth(y, m);
        while (remaining >= mlen && m < 12) bound (12) {
            remaining = remaining - mlen;
            m = m + 1;
            mlen = daysinmonth(y, m);
        }
        if (which == 1) then m else remaining + 1
    };
}

// Zero-pad a number to 2 digits
string pad(int n) {
    return if (n < 10) then "0" + str(n) else str(n);
}
