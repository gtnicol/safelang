<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Minimal bug-focused ruleset for safe-lang.

    Scope:
      * Imports cleanliness (unused, redundant).
      * Names (identifiers follow project conventions; no length minimums).
      * Real-bug pitfalls (fall-through, missing default, boolean simplification).
      * Upper ell literals, redundant modifiers, array style.

    Formatting (curly placement, needed braces, whitespace, line length,
    star-imports, empty catch blocks) is intentionally NOT enforced here —
    Spotless owns formatting, and the project style explicitly allows empty
    `catch (X ignored)` blocks and test-scope `import .*`.

    Generated ANTLR sources are excluded by the plugin's <sourceDirectory>.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="false"/>
        </module>
        <module name="RedundantImport"/>

        <!-- Naming (no length minimums — single-word names allowed) -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="ConstantName"/>
        <module name="LocalVariableName">
            <property name="format" value="^[a-zA-Z_][a-zA-Z0-9_]*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>

        <!-- Real-bug pitfalls -->
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="DefaultComesLast"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
    </module>
</module>
