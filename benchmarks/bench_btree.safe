program bench_btree;
import io;
import std;
import btree;
import binary;
import file;

const int N = 10000;
const string PATH = "/tmp/_safe_bench_btree.db";

int t0 = std:time();
BTree db = btree:create(PATH);

for i in 0..(N-1) {
    bytes k = binary:encode("k" + std:str(i));
    bytes v = binary:encode("v" + std:str(i));
    db = btree:put(db, k, v);
}

int t1 = std:time();

int found = 0;
for i in 0..(N-1) {
    bytes k = binary:encode("k" + std:str(i));
    bytes r = btree:get(db, k);
    found = if (binary:length(r) > 0) then found + 1 else found;
}

int t2 = std:time();

btree:close(db);
file:delete(PATH);

io:println("=== btree ===");
io:println("records: " + std:str(N));
io:println("write: " + std:str(t1 - t0) + "ms");
io:println("read: " + std:str(t2 - t1) + "ms");
io:println("found: " + std:str(found));
