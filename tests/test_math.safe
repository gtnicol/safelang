program test_math;
import std;
import math;
import test;

test:suite("abs", [
    fn() -> test:equal(std:str(math:abs(0 - 5)), "5", "abs negative int"),
    fn() -> test:equal(std:str(math:abs(5)), "5", "abs positive int"),
    fn() -> test:equal(std:str(math:abs(0)), "0", "abs zero")
]);

test:suite("sqrt and pow", [
    fn() -> test:near(math:sqrt(16.0), 4.0, 0.001, "sqrt 16"),
    fn() -> test:near(math:sqrt(9.0), 3.0, 0.001, "sqrt 9"),
    fn() -> test:near(math:sqrt(2.0), 1.41421, 0.001, "sqrt 2"),
    fn() -> test:near(math:pow(2.0, 10.0), 1024.0, 0.001, "pow 2^10"),
    fn() -> test:near(math:pow(3.0, 3.0), 27.0, 0.001, "pow 3^3"),
    fn() -> test:near(math:pow(5.0, 0.0), 1.0, 0.001, "pow 5^0")
]);

test:suite("min and max", [
    fn() -> test:equal(std:str(math:min(3, 7)), "3", "min int"),
    fn() -> test:equal(std:str(math:max(3, 7)), "7", "max int"),
    fn() -> test:equal(std:str(math:min(0 - 1, 1)), "-1", "min negative"),
    fn() -> test:equal(std:str(math:max(0 - 1, 1)), "1", "max negative")
]);

test:suite("floor ceil round", [
    fn() -> test:equal(std:str(math:floor(3.7)), "3", "floor 3.7"),
    fn() -> test:equal(std:str(math:floor(0.0 - 1.2)), "-2", "floor -1.2"),
    fn() -> test:equal(std:str(math:ceil(3.2)), "4", "ceil 3.2"),
    fn() -> test:equal(std:str(math:ceil(0.0 - 1.8)), "-1", "ceil -1.8"),
    fn() -> test:equal(std:str(math:round(3.5)), "4", "round 3.5"),
    fn() -> test:equal(std:str(math:round(3.4)), "3", "round 3.4")
]);

test:suite("log and exp", [
    fn() -> test:near(math:log(1.0), 0.0, 0.001, "log 1"),
    fn() -> test:near(math:exp(0.0), 1.0, 0.001, "exp 0"),
    fn() -> test:near(math:exp(1.0), math.E, 0.001, "exp 1 = E"),
    fn() -> test:near(math:log10(100.0), 2.0, 0.001, "log10 100")
]);

test:suite("trig", [
    fn() -> test:near(math:sin(0.0), 0.0, 0.001, "sin 0"),
    fn() -> test:near(math:cos(0.0), 1.0, 0.001, "cos 0"),
    fn() -> test:near(math:tan(0.0), 0.0, 0.001, "tan 0"),
    fn() -> test:near(math:asin(1.0), math.PI / 2.0, 0.001, "asin 1"),
    fn() -> test:near(math:acos(1.0), 0.0, 0.001, "acos 1"),
    fn() -> test:near(math:atan(0.0), 0.0, 0.001, "atan 0"),
    fn() -> test:near(math:atan2(1.0, 1.0), math.PI / 4.0, 0.001, "atan2 1 1")
]);

test:suite("factorial", [
    fn() -> test:equal(std:str(math:factorial(0)), "1", "factorial 0"),
    fn() -> test:equal(std:str(math:factorial(1)), "1", "factorial 1"),
    fn() -> test:equal(std:str(math:factorial(5)), "120", "factorial 5"),
    fn() -> test:equal(std:str(math:factorial(10)), "3628800", "factorial 10")
]);

test:suite("gcd and lcm", [
    fn() -> test:equal(std:str(math:gcd(12, 8)), "4", "gcd 12 8"),
    fn() -> test:equal(std:str(math:gcd(7, 3)), "1", "gcd 7 3"),
    fn() -> test:equal(std:str(math:lcm(4, 6)), "12", "lcm 4 6"),
    fn() -> test:equal(std:str(math:lcm(3, 5)), "15", "lcm 3 5")
]);

test:suite("prime", [
    fn() -> test:falsy(math:prime(1), "1 not prime"),
    fn() -> test:truthy(math:prime(2), "2 is prime"),
    fn() -> test:truthy(math:prime(13), "13 is prime"),
    fn() -> test:falsy(math:prime(15), "15 not prime")
]);

test:suite("fib", [
    fn() -> test:equal(std:str(math:fib(0)), "0", "fib 0"),
    fn() -> test:equal(std:str(math:fib(1)), "0", "fib 1"),
    fn() -> test:equal(std:str(math:fib(7)), "8", "fib 7"),
    fn() -> test:equal(std:str(math:fib(10)), "34", "fib 10")
]);

test:suite("clamp and sign", [
    fn() -> test:equal(std:str(math:clamp(5, 0, 10)), "5", "clamp within"),
    fn() -> test:equal(std:str(math:clamp(0 - 5, 0, 10)), "0", "clamp below"),
    fn() -> test:equal(std:str(math:clamp(15, 0, 10)), "10", "clamp above"),
    fn() -> test:equal(std:str(math:sign(42)), "1", "sign positive"),
    fn() -> test:equal(std:str(math:sign(0 - 7)), "-1", "sign negative"),
    fn() -> test:equal(std:str(math:sign(0)), "0", "sign zero")
]);

test:suite("sum", [
    fn() -> test:equal(std:str(math:sum([1, 2, 3, 4, 5])), "15", "sum ints")
]);

test:suite("constants", [
    fn() -> test:near(math.PI, 3.14159, 0.001, "PI"),
    fn() -> test:near(math.E, 2.71828, 0.001, "E")
]);

test:done();
